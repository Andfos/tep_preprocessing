params {
    adapter_file = "Truseq3-PE.fa"
}

process {
    withName: 'TRIMMOMATIC_TETETETETETETE' {

        ext.args = {
            def args = [
                '-phred33',
                "ILLUMINACLIP:${params.adapter_file}:2:30:10 LEADING:3 TRAILING:3 SLIDINGWINDOW:4:15 MINLEN:36"

            ]
            return args.join(' \\')
        }
    
        container = 'community.wave.seqera.io/library/trimmomatic:0.39--a688969e471089d7'

        publishDir = [
            path: {"${params.outdir}/trimmomatic"},
            mode: 'copy',
            saveAs: { filename -> filename.equals(versions.yml) ? null: filename}
        ]
    }
}

process {
    withName: 'STAR_ALIGN' {
        ext.args = [
            '--sjdbScore 2',
            '--outFilterMismatchNmax 10',
            '--chimSegmentMin 1',
            '--outFilterIntronMotifs None'
        ].join(' ')
    }


    
}


process {
    withName: 'PICARD_ADDORREPLACEREADGROUPS' {
        ext.args = { [
            "--RGLB RNAseq",
            "--RGPL illumina",
            "--RGPU platform1",
            "--RGSM ${meta.id}",
            "--VALIDATION_STRINGENCY LENIENT",
            "--TMP_DIR ${meta.id}",
            "--CREATE_INDEX true"
        ].join(' \\') }
    }
}

process {
    withName: 'SAMTOOLS_SORT' {

        container = 'community.wave.seqera.io/library/samtools:1.21--0d76da7c3cf7751c'
        ext.prefix = { "${meta.id}_sorted" }
        publishDir = [
            path: {"${params.outdir}/samtools_sorted"},
            mode: 'copy',
            saveAs: { filename -> filename.equals(versions.yml) ? null: filename}
        ]
    }
}



process {
    withName: 'SAMTOOLS_VIEW' {

        container = 'community.wave.seqera.io/library/samtools:1.21--0d76da7c3cf7751c'
        ext.prefix = { "${meta.id}_converted" }
        publishDir = [
            path: {"${params.outdir}/samtools_converted"},
            mode: 'copy',
            saveAs: { filename -> filename.equals(versions.yml) ? null: filename}
        ]
    }
}
